# README의 개발, 검증과 컨테이너 실행 명령이 사용하는 공개 기본값이다.
# Vite 개발 화면과 로컬 이미지에 표시할 버전을 정한다.
VITE_APP_VERSION=0.0.0-dev
# 빠른 시작 정적 이미지에 synthetic data 소스를 포함한다.
VITE_ENABLE_MOCK_DATA=true
# Vite 개발 서버의 기본 data source를 정한다.
VITE_DEV_DATA_SOURCE=mock
# 브라우저가 조회할 Backend 모니터링 API 버전을 정한다.
VITE_MONITORING_API_VERSION=v2
# 브라우저가 연결할 실시간 영상 방식을 정한다.
VITE_LIVE_VIDEO_MODE=mjpeg
# Vite 개발 서버의 pit 식별자를 정한다.
VITE_PIT_ID=pit-01
# Vite 개발 서버의 카메라 식별자를 정한다.
VITE_CAMERA_ID=camera-main
# HTTP data source를 사용하는 로컬 이미지에 mount할 runtime 설정의 host 경로를 정한다.
DASHBOARD_RUNTIME_CONFIG_FILE=runtime-config.json
# 배포할 GitHub Container Registry (GHCR) 이미지를 변경 불가능한 digest로 고정한다.
DASHBOARD_IMAGE=ghcr.io/ajin-scrap-monitoring/scrap-monitoring-dashboard@sha256:5de751cfae097c208b13d00dc5729e8ba9646b82baf1b3a6cea8572d9b194862
# Docker가 관리할 컨테이너 이름을 정한다.
DASHBOARD_CONTAINER_NAME=scrap-monitoring-dashboard
# Docker가 실행할 이미지 플랫폼을 정한다.
DASHBOARD_PLATFORM=linux/amd64
# 개발 및 단독 검증에서 host가 수신할 주소를 정한다.
DASHBOARD_BIND_ADDRESS=127.0.0.1
# host에서 컨테이너의 Transmission Control Protocol (TCP) 8080으로 연결할 port를 정한다.
DASHBOARD_HOST_PORT=8080
# 읽기 전용 컨테이너가 사용할 임시 file system 크기를 정한다.
DASHBOARD_TMPFS_SIZE=16m
# 배포 Repository가 Nginx에 읽기 전용으로 mount할 인증서 체인의 host 경로를 정한다.
DASHBOARD_TLS_CERTIFICATE_FILE=.secrets/tls/dashboard-fullchain.pem
# 배포 Repository가 Docker Secret으로 제공할 서버 개인 키의 host 경로를 정한다.
DASHBOARD_TLS_PRIVATE_KEY_FILE=.secrets/tls/dashboard-private-key.pem
# 운영 브라우저의 신뢰 저장소에 설치할 Root CA 인증서의 host 경로를 정한다.
DASHBOARD_ROOT_CA_FILE=.secrets/tls/root-ca.crt
