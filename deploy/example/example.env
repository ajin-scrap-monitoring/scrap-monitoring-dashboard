# compose.yaml이 읽는 배포 환경별 값의 예시다. 각 값을 배포 환경의 값으로 바꾼다.
# Release의 image-reference.txt에 기록된 digest 참조를 사용한다.
DASHBOARD_IMAGE=ghcr.io/ajin-scrap-monitoring/scrap-monitoring-dashboard@sha256:<digest>
# 브라우저가 접속할 host 주소와 HTTPS port를 정한다.
DASHBOARD_BIND_ADDRESS=10.0.0.10
DASHBOARD_HTTPS_PORT=443
# 서버 인증서와 중간 CA 인증서를 이은 chain 파일의 host 경로를 정한다.
DASHBOARD_TLS_CERTIFICATE_FILE=/srv/dashboard/tls/dashboard-fullchain.pem
# Docker Secret으로 연결할 서버 개인 키의 host 경로를 정한다.
DASHBOARD_TLS_PRIVATE_KEY_FILE=/srv/dashboard/tls/dashboard-private-key.pem
# 서버 개인 키 파일의 group ID를 정한다. 개인 키 group이 101이면 101을 사용한다.
DASHBOARD_TLS_KEY_GROUP_ID=101
# pitId와 cameraId를 담은 runtime 설정 파일의 host 경로를 정한다.
DASHBOARD_RUNTIME_CONFIG_FILE=/srv/dashboard/runtime-config.json
# Backend와 Camera Media Service가 연결된 Docker network 이름을 정한다.
DASHBOARD_SERVICE_NETWORK=scrap-monitoring
