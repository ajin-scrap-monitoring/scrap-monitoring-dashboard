# 원격 개발 Compose가 기존 서비스에 연결할 때 사용하는 공개 설정 예시다.
# Docker가 개발 gateway를 연결할 기존 network를 정한다.
DASHBOARD_DEV_NETWORK=monitoring
# Nginx가 API 요청을 전달할 Backend의 내부 host와 port를 정한다.
DASHBOARD_BACKEND_UPSTREAM=backend:8000
# Nginx가 인증한 영상 요청을 전달할 Media Service의 내부 host와 port를 정한다.
DASHBOARD_MEDIA_UPSTREAM=media:8889
# Vite 개발 서버가 조회할 pit 식별자를 정한다.
VITE_PIT_ID=pit-01
# Vite 개발 서버가 조회할 camera 식별자를 정한다.
VITE_CAMERA_ID=camera-main
